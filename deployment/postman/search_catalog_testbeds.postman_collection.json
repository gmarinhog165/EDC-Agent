  "item": [
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "List Contract Definitions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Api-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n   \"@context\": [\n        \"https://w3id.org/edc/connector/management/v0.0.1\"\n    ],\n    \"@type\": \"QuerySpec\"\n}"
            },
            "url": "{{HOST}}/api/management/v3/contractdefinitions/request"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const negotiations = pm.response.json();",
                  "const items = Array.isArray(negotiations) ? negotiations : [];",
                  "pm.collectionVariables.set('cleanupContractNegotiations', JSON.stringify(items));",
                  "pm.collectionVariables.set('cleanupContractNegotiationIndex', '0');",
                  "if (items.length > 0) {",
                  "  postman.setNextRequest('Delete Contract Definition (loop)');",
                  "} else {",
                  "  postman.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Contract Definition (loop)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": "{{HOST}}/api/management/v3/contractdefinitions/{{cleanupContractNegotiationId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const negotiations = JSON.parse(pm.collectionVariables.get('cleanupContractNegotiations') || '[]');",
                  "const index = Number(pm.collectionVariables.get('cleanupContractNegotiationIndex') || '0');",
                  "if (index >= negotiations.length) {",
                  "  postman.setNextRequest(null);",
                  "  pm.execution.skipRequest();",
                  "}",
                  "const negotiation = negotiations[index] || {};",
                  "const id = negotiation['@id'] || negotiation.id;",
                  "if (!id) {",
                  "  pm.collectionVariables.set('cleanupContractNegotiationIndex', String(index + 1));",
                  "  postman.setNextRequest('Delete Contract Definition (loop)');",
                  "  pm.execution.skipRequest();",
                  "}",
                  "pm.collectionVariables.set('cleanupContractNegotiationId', id);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const negotiations = JSON.parse(pm.collectionVariables.get('cleanupContractNegotiations') || '[]');",
                  "const index = Number(pm.collectionVariables.get('cleanupContractNegotiationIndex') || '0');",
                  "const nextIndex = index + 1;",
                  "pm.collectionVariables.set('cleanupContractNegotiationIndex', String(nextIndex));",
                  "if (nextIndex < negotiations.length) {",
                  "  postman.setNextRequest('Delete Contract Definition (loop)');",
                  "} else {",
                  "  postman.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
